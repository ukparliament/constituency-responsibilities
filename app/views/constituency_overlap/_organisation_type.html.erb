<% if organisation_type.organisation_type_id == organisations.first.organisation_type_id -%>
	<div id="<%= organisation_type.organisation_type_label.gsub( ' ', '-' ).downcase %>">
		<%= content_tag( 'h2', organisation_type.organisation_type_label ) %>
		<ol class="unnumbered link-list">
			<%= render :partial => 'constituency_overlap/organisation', :object => organisation_type %>
			
<% else -%>
	
	<% if organisation_type.organisation_type_label != organisations[organisation_type_counter - 1].organisation_type_label -%>
	
			</ol>
		</div>
		<div id="<%= organisation_type.organisation_type_label.gsub( ' ', '-' ).downcase %>">
			<%= content_tag( 'h2', organisation_type.organisation_type_label ) %>
			<ol class="unnumbered link-list">
				<%= render :partial => 'constituency_overlap/organisation', :object => organisation_type %>
			
	<% else -%>
		<%= render :partial => 'constituency_overlap/organisation', :object => organisation_type %>
	<% end -%>
		
	<% if organisation_type.organisation_type_id == organisations.last.organisation_type_id -%>
			</ol>
		</div>
	<% end -%>
<% end -%>