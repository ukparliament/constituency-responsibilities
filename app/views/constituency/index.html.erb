<div id="countries">
	<%= content_tag( 'h2', 'Countries' ) %>
	<ol class="unnumbered link-list">
		<%= render :partial => 'constituency_country/country', :collection => @countries %>
	</ol>
</div>

<div id="constituency-areas">
	<%= content_tag( 'h2', 'Constituency areas' ) %>
	<%= list_item_count_sentence( 'constituency area', @constituencies.size ) %>
	<%= render :partial => 'library_design/feeds/feeds' %>
	<ol class="unnumbered link-list">
		<%= render :partial => 'constituency', :collection => @constituencies %>
	</ol>
</div>